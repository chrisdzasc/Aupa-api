{
  "compilerOptions": {
    // Ubicación de archivos
    "rootDir": "./src",
    "outDir": "./dist",

    // Entorno: Node con CommonJS (lo que usa Express)
    "module": "commonjs",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022"],
    "types": ["node"],

    // Interoperabilidad
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // Verificación de tipos
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Salida
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}