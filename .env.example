# Servidor
PORT=3001

# Base de datos (usadas por la API en tiempo de ejecución)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=aupa_db

# URL de conexión (usada por Prisma CLI para migraciones)
# Formato: mysql://usuario:password@host:puerto/base
DATABASE_URL=

# Autenticación: mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=