generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ============================================
// USUARIOS DEL SISTEMA
// ============================================

model Profesionista {
  id                Int      @id @default(autoincrement())
  nombre            String   @db.VarChar(100)
  email             String   @unique @db.VarChar(100)
  passwordHash      String   @db.VarChar(255)
  cedulaProfesional String?  @db.VarChar(20)
  activo            Boolean  @default(true)
  ultimoExpediente  Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pacientes Paciente[]
  citas     Cita[]
}

model Tutor {
  id           Int        @id @default(autoincrement())
  nombre       String     @db.VarChar(100)
  parentesco   Parentesco
  telefono     String     @db.VarChar(15)
  email        String     @unique @db.VarChar(100)
  passwordHash String?    @db.VarChar(255)

  // Acceso a la app móvil
  tieneAcceso         Boolean   @default(true)
  cuentaConfirmada    Boolean   @default(false)
  debeCambiarPassword Boolean   @default(true)
  tokenConfirmacion   String?   @db.VarChar(255)
  tokenExpira         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pacientes Paciente[]
}

// ============================================
// PACIENTE Y SU EXPEDIENTE
// ============================================

model Paciente {
  id               Int      @id @default(autoincrement())
  numeroExpediente String   @db.VarChar(20)
  nombre           String   @db.VarChar(100)
  sexo             Sexo
  fechaNacimiento  DateTime @db.Date
  activo           Boolean  @default(true)

  // Historial perinatal
  semanasGestacion         Int?
  tipoParto                TipoParto?
  pesoNacerKg              Decimal?   @db.Decimal(5, 3)
  tallaNacerCm             Decimal?   @db.Decimal(4, 1)
  perimetroCefalicoNacerCm Decimal?   @db.Decimal(4, 1)

  // Antecedentes nutricionales
  tipoAlimentacion     String? @db.VarChar(60)
  inicioComplementaria String? @db.VarChar(60)

  observaciones String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  profesionistaId Int
  profesionista   Profesionista @relation(fields: [profesionistaId], references: [id])

  tutorId Int
  tutor   Tutor @relation(fields: [tutorId], references: [id])

  mediciones             Medicion[]
  citas                  Cita[]
  alertas                AlertaMedica[]
  antecedentesFamiliares AntecedenteFamiliar[]

  @@unique([profesionistaId, numeroExpediente])
  @@index([profesionistaId])
  @@index([tutorId])
}

model AlertaMedica {
  id          Int        @id @default(autoincrement())
  descripcion String     @db.VarChar(60)
  tipo        TipoAlerta
  createdAt   DateTime   @default(now())

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
}

model AntecedenteFamiliar {
  id        Int      @id @default(autoincrement())
  condicion String   @db.VarChar(60)
  detalle   String?  @db.VarChar(300)
  createdAt DateTime @default(now())

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
}

// ============================================
// MEDICIONES Y CITAS
// ============================================

model Medicion {
  id            Int      @id @default(autoincrement())
  fechaConsulta DateTime @db.Date

  // Antropometría básica
  pesoKg              Decimal  @db.Decimal(6, 3)
  tallaCm             Decimal  @db.Decimal(5, 1)
  perimetroCefalicoCm Decimal? @db.Decimal(4, 1)

  // Complementarias
  perimetroBraquialCm Decimal? @db.Decimal(4, 1)
  cinturaCm           Decimal? @db.Decimal(5, 1)
  abdomenCm           Decimal? @db.Decimal(5, 1)
  caderaCm            Decimal? @db.Decimal(5, 1)
  pantorrillaCm       Decimal? @db.Decimal(4, 1)
  tricipitalMm        Decimal? @db.Decimal(4, 1)

  notas String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  @@index([pacienteId])
}

model Cita {
  id        Int        @id @default(autoincrement())
  fechaHora DateTime
  estado    EstadoCita @default(PENDIENTE)
  notas     String?    @db.VarChar(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Cascade)

  profesionistaId Int
  profesionista   Profesionista @relation(fields: [profesionistaId], references: [id])

  @@index([pacienteId])
  @@index([profesionistaId])
}

// ============================================
// ENUMERADORES
// ============================================

enum Sexo {
  M
  F
}

enum TipoParto {
  VAGINAL
  CESAREA
}

enum Parentesco {
  MADRE
  PADRE
  ABUELO
  TUTOR_LEGAL
  OTRO
}

enum TipoAlerta {
  ALERGIA
  CONDICION_CRONICA
}

enum EstadoCita {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  CANCELADA
}
